﻿@{
ViewData["Title"] = "Админ панель";
}

<div class="container">
    <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 1.5rem;">
        Админ панель
    </h1>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 1rem;">
        <div class="card">
            <div class="card-header" style="background: var(--brown-primary); color: white;">
                <h5 style="margin: 0;">Управление пользователями</h5>
            </div>
            <div class="card-body">
                <p style="color: var(--text-muted); margin-bottom: 1rem;">
                    Просмотр и редактирование пользователей, назначение ролей
                </p>
                <a asp-action="Users" class="btn btn-primary" style="text-decoration: none; display: inline-block;">
                    Перейти к пользователям →
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header" style="background: var(--brown-primary); color: white;">
                <h5 style="margin: 0;">Информация</h5>
            </div>
            <div class="card-body">
                <p style="color: var(--text-muted); margin-bottom: 0.5rem;">
                    Добро пожаловать в панель администратора
                </p>
                <p style="color: var(--text-muted);">
                    Вы можете управлять пользователями и их ролями
                </p>
            </div>
        </div>
    </div>
</div>