@model IEnumerable<last_test_server.Models.Product>

<div class="container">
    <!-- Hero-блок -->
    <div class="hero">
        <h1>Добро пожаловать в магазин</h1>
        <p class="lead">Лучшие товары от лучших продавцов</p>

        @if (!User.Identity.IsAuthenticated)
        {
            <div class="btn-group">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Регистрация</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline">Вход</a>
            </div>
        }
        else
        {
            <div>
                <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Здравствуйте, <strong>@User.Identity.Name</strong></p>
                <div class="btn-group">
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge">Администратор</span>
                    }
                    @if (User.IsInRole("Seller"))
                    {
                        <span class="badge">Продавец</span>
                    }
                    @if (User.IsInRole("Buyer"))
                    {
                        <span class="badge">Покупатель</span>
                    }
                </div>
            </div>
        }
    </div>

    <h2 class="section-title">Все товары</h2>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p style="font-size: 1.2rem;">✨ Товаров пока нет</p>
            <p style="font-size: 0.9rem; margin-top: 0.5rem;">Загляните позже, скоро появятся новинки</p>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <img class="product-img" src="@product.ImageURL" alt="@product.Name"
                         onerror="this.src='https://via.placeholder.com/300x220?text=No+Image'">

                    <div class="product-body">
                        <div class="product-title">
                            @product.Name
                            @if (User.IsInRole("Buyer") && User.Identity.IsAuthenticated)
                            {
                                <button class="add-to-cart-icon" data-product-id="@product.Id" title="Добавить в корзину">
                                    🛒
                                </button>
                            }
                        </div>
                        <div class="price">@product.Cost.ToString("N0") ₽</div>
                        @if (!string.IsNullOrEmpty(product.Composition))
                        {
                            <div class="composition">
                                @(product.Composition.Length > 100 ? product.Composition.Substring(0, 100) + "..." : product.Composition)
                            </div>
                        }
                        <div class="seller">👤 Продавец: @(product.Seller?.FullName ?? product.SellerId)</div>
                    </div>

                    <div class="cart-controls">
                        @if (User.IsInRole("Buyer") && User.Identity.IsAuthenticated)
                        {
                            <input type="number" class="quantity-input" data-id="@product.Id" value="1" min="1" max="99">
                            <button class="btn-cart add-to-cart-btn" data-product-id="@product.Id">В корзину</button>
                        }
                        else if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-cart" style="text-decoration: none; display: block;">Войдите, чтобы купить</a>
                        }
                        else
                        {
                            <button class="btn-cart" disabled>Только для покупателей</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.add-to-cart-btn').click(function() {
                var productId = $(this).data('product-id');
                var quantity = $(`.quantity-input[data-id='${productId}']`).val();
                addToCart(productId, quantity);
            });

            $('.add-to-cart-icon').click(function() {
                var productId = $(this).data('product-id');
                addToCart(productId, 1);
            });

            function addToCart(productId, quantity) {
                $.ajax({
                    url: '@Url.Action("AddToCart", "Cart")',
                    type: 'POST',
                    data: { productId: productId, quantity: parseInt(quantity) },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            showToast('✓ ' + response.message);
                            updateCartCount();
                        } else {
                            showToast('⚠ ' + response.message);
                        }
                    },
                    error: function() {
                        showToast('❌ Ошибка при добавлении в корзину');
                    }
                });
            }

            function updateCartCount() {
                $.ajax({
                    url: '@Url.Action("GetCartCount", "Cart")',
                    type: 'GET',
                    success: function(count) {
                        $('.cart-count').text(count);
                    }
                });
            }

            function showToast(message) {
                $('.toast-notify').remove();
                var toast = $(`<div class="toast-notify">${message}</div>`);
                $('body').append(toast);
                setTimeout(function() {
                    toast.fadeOut(300, function() { $(this).remove(); });
                }, 2500);
            }
        });
    </script>
}

@if (User.Identity.IsAuthenticated)
{
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
}