@model last_test_server.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Оформление заказа";
}

<div class="container">
    <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 1.5rem;">
        Оформление заказа
    </h1>

    <div style="display: grid; grid-template-columns: 1fr 0.8fr; gap: 1.5rem;">
        <div class="card">
            <div class="card-body" style="padding: 1.5rem;">
                <form asp-action="Checkout" method="post">
                    <div asp-validation-summary="ModelOnly" class="empty-state" style="padding: 0.75rem; margin-bottom: 1rem; font-size: 0.9rem;"></div>

                    <input type="hidden" asp-for="@Model.PhoneNumber" />
                    <input type="hidden" asp-for="@Model.UserName" />
                    <input type="hidden" asp-for="@Model.Email" />

                    <div style="margin-bottom: 1.5rem;">
                        <label asp-for="Address" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--brown-dark);">Адрес доставки</label>
                        <textarea asp-for="Address" rows="3" style="width: 100%; padding: 0.75rem; border: 1px solid var(--brown-light); border-radius: var(--radius-sm); font-family: inherit;"
                                  placeholder="Город, улица, дом, квартира"></textarea>
                        <span asp-validation-for="Address" style="color: #dc3545; font-size: 0.875rem;"></span>
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        <label asp-for="Comment" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--brown-dark);">Комментарий к заказу</label>
                        <textarea asp-for="Comment" rows="3" style="width: 100%; padding: 0.75rem; border: 1px solid var(--brown-light); border-radius: var(--radius-sm); font-family: inherit;"
                                  placeholder="Пожелания к заказу..."></textarea>
                    </div>

                    <div style="display: flex; justify-content: space-between; gap: 1rem;">
                        <a asp-action="Index" class="btn btn-outline" style="text-decoration: none; text-align: center;">
                            Назад в корзину
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Подтвердить заказ
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header" style="background: var(--brown-primary); color: white; padding: 1rem; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
                <h5 style="margin: 0;">Детали заказа</h5>
            </div>
            <div class="card-body" style="padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                    <span>Сумма заказа:</span>
                    <strong style="font-size: 1.1rem;">@Model.TotalPrice ₽</strong>
                </div>
                <hr style="border-color: var(--brown-light); margin: 1rem 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>К оплате:</span>
                    <strong style="font-size: 1.3rem; color: var(--brown-primary);">@Model.TotalPrice ₽</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}