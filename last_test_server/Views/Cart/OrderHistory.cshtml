@model IEnumerable<last_test_server.Models.Order>

@{
    ViewData["Title"] = "История заказов";
    var orders = Model.ToList();
}

<div class="container">
    <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 1.5rem;">
        📋 История заказов
    </h1>

    @if (!orders.Any())
    {
        <div class="empty-state">
            <div style="font-size: 4rem;">📋</div>
            <h3 style="margin-top: 1rem;">У вас пока нет заказов</h3>
            <a href="/Home/Index" class="btn btn-primary" style="text-decoration: none; display: inline-block; margin-top: 1rem;">
                🏪 Перейти к покупкам
            </a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem;">
            @foreach (var order in orders)
            {
                string statusText = "";
                string statusColor = "";

                if (order.Status == last_test_server.Models.OrderStatus.Pending)
                {
                    statusText = "Ожидает обработки";
                    statusColor = "#ffc107";
                }
                else if (order.Status == last_test_server.Models.OrderStatus.Confirmed)
                {
                    statusText = "Подтвержден";
                    statusColor = "#17a2b8";
                }
                else if (order.Status == last_test_server.Models.OrderStatus.Shipping)
                {
                    statusText = "В доставке";
                    statusColor = "#007bff";
                }
                else if (order.Status == last_test_server.Models.OrderStatus.Delivered)
                {
                    statusText = "Доставлен";
                    statusColor = "#28a745";
                }
                else if (order.Status == last_test_server.Models.OrderStatus.Cancelled)
                {
                    statusText = "Отменен";
                    statusColor = "#dc3545";
                }

                <div class="card" style="display: flex; flex-direction: column; height: 100%;">
                    <div class="card-header" style="background: var(--brown-primary); color: white; padding: 1rem; display: flex; justify-content: space-between; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
                        <strong>Заказ #@order.Id</strong>
                        <span>@order.OrderDate.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="card-body" style="padding: 1.2rem; flex: 1;">
                        <div style="margin-bottom: 0.5rem;">
                            <strong>Статус:</strong>
                            <span style="background: @statusColor; color: white; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; display: inline-block;">@statusText</span>
                        </div>

                        <div style="margin-bottom: 0.5rem;">
                            <strong>Товаров:</strong> @order.OrderItems.Sum(x => x.Quantity) шт.
                        </div>

                        <div style="margin-bottom: 0.75rem;">
                            <strong>Сумма:</strong> <span style="color: var(--brown-primary); font-weight: 700;">@order.TotalAmount ₽</span>
                        </div>

                        <hr style="border-color: var(--brown-light); margin: 0.75rem 0;">

                        <h6 style="margin-bottom: 0.5rem;">Состав заказа:</h6>
                        <ul style="list-style: none; padding-left: 0;">
                            @foreach (var item in order.OrderItems.Take(3))
                            {
                                <li style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem;">
                                    • @item.ProductName x @item.Quantity = @(item.PriceAtTime * item.Quantity) ₽
                                </li>
                            }
                            @if (order.OrderItems.Count() > 3)
                            {
                                <li style="font-size: 0.85rem; color: var(--text-light);">
                                    ...и еще @(order.OrderItems.Count() - 3) товаров
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    }
</div>