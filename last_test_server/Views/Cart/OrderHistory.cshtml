@model IEnumerable<last_test_server.Models.Order>

@{
    ViewData["Title"] = "История заказов";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="bi bi-clock-history"></i> История заказов
    </h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt" style="font-size: 4rem; color: #6c757d;"></i>
            <h3 class="mt-3">У вас пока нет заказов</h3>
            <a href="/Home/Index" class="btn btn-primary mt-3">
                <i class="bi bi-shop"></i> Перейти к покупкам
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white">
                            <div class="d-flex justify-content-between">
                                <span>Заказ #@order.Id</span>
                                <span>@order.OrderDate.ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Статус:</strong>
                                @if (order.Status == last_test_server.Models.OrderStatus.Pending)
                                {
                                    <span class="badge bg-warning">Ожидает обработки</span>
                                }
                                else if (order.Status == last_test_server.Models.OrderStatus.Confirmed)
                                {
                                    <span class="badge bg-info">Подтвержден</span>
                                }
                                else if (order.Status == last_test_server.Models.OrderStatus.Shipping)
                                {
                                    <span class="badge bg-primary">В доставке</span>
                                }
                                else if (order.Status == last_test_server.Models.OrderStatus.Delivered)
                                {
                                    <span class="badge bg-success">Доставлен</span>
                                }
                                else if (order.Status == last_test_server.Models.OrderStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">Отменен</span>
                                }
                            </div>

                            <div class="mb-2">
                                <strong>Товаров:</strong> @order.OrderItems.Sum(x => x.Quantity) шт.
                            </div>

                            <div class="mb-2">
                                <strong>Сумма:</strong> @order.TotalAmount ₽
                            </div>

                            <hr />

                            <h6>Состав заказа:</h6>
                            <ul class="list-unstyled">
                                @foreach (var item in order.OrderItems.Take(3))
                                {
                                    <li>• @item.ProductName x @item.Quantity = @(item.PriceAtTime* item.Quantity) ₽</li>
                                }
                                @if (order.OrderItems.Count() > 3)
                                {
                                    <li class="text-muted">...и еще @(order.OrderItems.Count() - 3) товаров</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>