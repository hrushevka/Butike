@model IEnumerable<last_test_server.Models.CartItem>

@{
    ViewData["Title"] = "Моя корзина";
    var cartItems = Model.ToList();
    var totalItems = cartItems.Sum(x => x.Quantity);
    var totalPrice = cartItems.Sum(x => (x.Product?.Cost ?? 0) * x.Quantity);
}

<div class="container">
    <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 1.5rem;">
        🛒 Моя корзина
    </h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-notify" style="position: static; margin-bottom: 1rem; background: var(--brown-primary);">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (!cartItems.Any())
    {
        <div class="empty-state">
            <div style="font-size: 4rem;">🛒</div>
            <h3 style="margin-top: 1rem;">Ваша корзина пуста</h3>
            <p style="color: var(--text-muted);">Добавьте товары из каталога</p>
            <a href="/" class="btn btn-primary" style="text-decoration: none; display: inline-block; margin-top: 1rem;">
                🏪 Перейти к покупкам
            </a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: 1fr 0.8fr; gap: 1.5rem;">
            <!-- Список товаров -->
            <div class="card">
                <div class="card-body" style="padding: 1.5rem;">
                    @foreach (var item in cartItems)
                    {
                        var itemTotal = (item.Product?.Cost ?? 0) * item.Quantity;
                        <div class="cart-item" data-id="@item.Id" style="display: flex; gap: 1rem; margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--brown-light); align-items: center;">
                            <div style="width: 80px; flex-shrink: 0;">
                                <img src="@item.Product?.ImageURL" style="width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-sm); background: var(--brown-light);"
                                     onerror="this.src='https://via.placeholder.com/80x80?text=No+Image'">
                            </div>
                            <div style="flex: 2;">
                                <h6 style="margin-bottom: 0.25rem;">@item.Product?.Name</h6>
                                <small style="color: var(--text-muted);">@(item.Product?.Cost.ToString("N0") ?? "0") ₽ / шт</small>
                            </div>
                            <div style="width: 120px;">
                                <div style="display: flex; gap: 0.25rem;">
                                    <button class="decrement" data-id="@item.Id" style="background: var(--brown-light); border: none; border-radius: var(--radius-sm); width: 30px; cursor: pointer; font-size: 1.1rem;">-</button>
                                    <input type="number" class="quantity-input" data-id="@item.Id" value="@item.Quantity" min="1" max="99" style="width: 50px; text-align: center;">
                                    <button class="increment" data-id="@item.Id" style="background: var(--brown-light); border: none; border-radius: var(--radius-sm); width: 30px; cursor: pointer; font-size: 1.1rem;">+</button>
                                </div>
                            </div>
                            <div style="width: 100px; text-align: right;">
                                <strong style="color: var(--brown-primary);">@itemTotal ₽</strong>
                            </div>
                            <div>
                                <button class="remove-item" data-id="@item.Id" style="background: none; border: none; color: #dc3545; cursor: pointer; font-size: 1.2rem;">🗑️</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Блок итого -->
            <div class="card">
                <div class="card-header" style="background: var(--brown-primary); color: white; padding: 1rem; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
                    <h5 style="margin: 0;">Итого</h5>
                </div>
                <div class="card-body" style="padding: 1.5rem;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span>Товаров:</span>
                        <strong id="total-items">@totalItems</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                        <span>Сумма:</span>
                        <strong style="font-size: 1.25rem; color: var(--brown-primary);" id="total-price">@totalPrice ₽</strong>
                    </div>
                    <hr style="border-color: var(--brown-light); margin: 1rem 0;">
                    <a asp-action="Checkout" class="btn btn-primary" style="text-decoration: none; display: block; text-align: center; width: 100%; margin-bottom: 0.5rem;">
                        💳 Оформить заказ
                    </a>
                    <button id="clear-cart" class="btn btn-outline" style="width: 100%;">
                        🗑️ Очистить корзину
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        function updateQuantity(id, quantity) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { cartItemId: id, quantity: quantity },
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    }
                }
            });
        }

        function removeFromCart(id) {
            if (confirm('Удалить товар из корзины?')) {
                $.ajax({
                    url: '@Url.Action("RemoveFromCart", "Cart")',
                    type: 'POST',
                    data: { cartItemId: id },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    }
                });
            }
        }

        $('.quantity-input').on('change', function() {
            var id = $(this).data('id');
            var quantity = parseInt($(this).val());
            if (isNaN(quantity) || quantity < 1) quantity = 1;
            updateQuantity(id, quantity);
        });

        $('.increment').click(function() {
            var id = $(this).data('id');
            var input = $('.quantity-input[data-id="' + id + '"]');
            var quantity = parseInt(input.val()) + 1;
            updateQuantity(id, quantity);
        });

        $('.decrement').click(function() {
            var id = $(this).data('id');
            var input = $('.quantity-input[data-id="' + id + '"]');
            var quantity = parseInt(input.val()) - 1;
            if (quantity >= 1) {
                updateQuantity(id, quantity);
            }
        });

        $('.remove-item').click(function() {
            var id = $(this).data('id');
            removeFromCart(id);
        });

        $('#clear-cart').click(function() {
            if (confirm('Очистить всю корзину?')) {
                $.ajax({
                    url: '@Url.Action("ClearCart", "Cart")',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    }
                });
            }
        });
    });
</script>

@if (User.Identity.IsAuthenticated)
{
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
}