@model IEnumerable<last_test_server.Models.CartItem>

@{
    ViewData["Title"] = "Моя корзина";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="bi bi-cart-fill"></i> Моя корзина
    </h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 4rem; color: #6c757d;"></i>
            <h3 class="mt-3">Ваша корзина пуста</h3>
            <p class="text-muted">Добавьте товары из каталога</p>
            <a href="/" class="btn btn-primary mt-3">
                <i class="bi bi-shop"></i> Перейти к покупкам
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        @foreach (var item in Model)
                        {
                            <div class="row mb-3 pb-3 border-bottom align-items-center" id="cart-item-@item.Id">
                                <div class="col-md-2">
                                    <img src="@item.Product?.ImageURL" class="img-fluid rounded"
                                         style="max-height: 80px; width: 100%; object-fit: cover;"
                                         onerror="this.src='https://via.placeholder.com/80x80?text=No+Image'">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-0">@item.Product?.Name</h6>
                                    <small class="text-muted">@item.Product?.Cost.ToString("N0") ₽ / шт</small>
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group input-group-sm">
                                        <button class="btn btn-outline-secondary decrement" data-id="@item.Id">-</button>
                                        <input type="number" class="form-control text-center quantity-input"
                                               data-id="@item.Id" value="@item.Quantity" min="1" max="99">
                                        <button class="btn btn-outline-secondary increment" data-id="@item.Id">+</button>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <h6 class="mb-0 text-primary item-total" data-id="@item.Id">
                                        @((item.Product?.Cost ?? 0) * item.Quantity) ₽
                                    </h6>
                                </div>
                                <div class="col-md-1 text-end">
                                    <button class="btn btn-sm btn-link text-danger remove-item" data-id="@item.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Итого</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Товаров:</span>
                            <strong id="total-items">@Model.Sum(x => x.Quantity)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Сумма:</span>
                            <strong class="h4 text-primary" id="total-price">@ViewBag.TotalPrice ₽</strong>
                        </div>
                        <hr />
                        <a asp-action="Checkout" class="btn btn-success w-100 mb-2">
                            <i class="bi bi-credit-card"></i> Оформить заказ
                        </a>
                        <button id="clear-cart" class="btn btn-outline-danger w-100">
                            <i class="bi bi-trash3"></i> Очистить корзину
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        function updateQuantity(id, quantity) {
            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { cartItemId: id, quantity: quantity },
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    }
                }
            });
        }

        function removeFromCart(id) {
            if (confirm('Удалить товар из корзины?')) {
                $.ajax({
                    url: '@Url.Action("RemoveFromCart", "Cart")',
                    type: 'POST',
                    data: { cartItemId: id },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    }
                });
            }
        }

        $('.quantity-input').on('change', function() {
            var id = $(this).data('id');
            var quantity = parseInt($(this).val());
            if (isNaN(quantity) || quantity < 1) quantity = 1;
            updateQuantity(id, quantity);
        });

        $('.increment').click(function() {
            var id = $(this).data('id');
            var input = $('.quantity-input[data-id="' + id + '"]');
            var quantity = parseInt(input.val()) + 1;
            updateQuantity(id, quantity);
        });

        $('.decrement').click(function() {
            var id = $(this).data('id');
            var input = $('.quantity-input[data-id="' + id + '"]');
            var quantity = parseInt(input.val()) - 1;
            if (quantity >= 1) {
                updateQuantity(id, quantity);
            }
        });

        $('.remove-item').click(function() {
            var id = $(this).data('id');
            removeFromCart(id);
        });

        $('#clear-cart').click(function() {
            if (confirm('Очистить всю корзину?')) {
                $.ajax({
                    url: '@Url.Action("ClearCart", "Cart")',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    }
                });
            }
        });
    });
</script>