@model last_test_server.Models.Order

@{
    ViewData["Title"] = "Заказ оформлен";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="text-center mb-5">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        <h1 class="mt-3">Заказ успешно оформлен!</h1>
        <p class="lead">Номер заказа: #@Model.Id</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Детали заказа</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Дата заказа:</strong><br>
                            @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        <div class="col-md-6">
                            <strong>Статус:</strong><br>
                            @if (Model.Status == last_test_server.Models.OrderStatus.Pending)
                            {
                                <span class="badge bg-warning">Ожидает обработки</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Телефон:</strong><br>
                            @Model.PhoneNumber
                        </div>
                        <div class="col-md-6">
                            <strong>Адрес доставки:</strong><br>
                            @Model.ShippingAddress
                        </div>
                    </div>

                    <hr />

                    <h6>Состав заказа:</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Кол-во</th>
                                <th>Цена</th>
                                <th>Сумма</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.PriceAtTime ₽</td>
                                    <td>@(item.PriceAtTime* item.Quantity) ₽</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Итого:</th>
                                <th>@Model.TotalAmount ₽</th>
                            </tr>
                        </tfoot>
                    </table>

                    @if (!string.IsNullOrEmpty(Model.Comment))
                    {
                        <div class="alert alert-info">
                            <strong>Комментарий к заказу:</strong><br>
                            @Model.Comment
                        </div>
                    }

                    <div class="text-center mt-4">
                        <a href="/Home/Index" class="btn btn-primary">
                            <i class="bi bi-shop"></i> Продолжить покупки
                        </a>
                        <a asp-action="OrderHistory" class="btn btn-outline-info">
                            <i class="bi bi-clock-history"></i> История заказов
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>