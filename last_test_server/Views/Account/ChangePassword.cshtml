@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container">
    <div style="max-width: 500px; margin: 0 auto;">
        <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 1.5rem;">
            Смена пароля
        </h1>

        <div class="card">
            <div class="card-header" style="background: var(--brown-primary); color: white; padding: 1rem;">
                <h4 style="margin: 0;">Изменение пароля</h4>
            </div>
            <div class="card-body" style="padding: 1.5rem;">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="empty-state" style="padding: 0.75rem; margin-bottom: 1rem; font-size: 0.9rem;"></div>

                    <div style="margin-bottom: 1rem;">
                        <label asp-for="OldPassword" style="display: block; margin-bottom: 0.25rem; font-weight: 500;">Текущий пароль</label>
                        <input asp-for="OldPassword" type="password" class="quantity-input" style="width: 100%; padding: 0.6rem;" />
                        <span asp-validation-for="OldPassword" style="color: #dc3545; font-size: 0.8rem;"></span>
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label asp-for="NewPassword" style="display: block; margin-bottom: 0.25rem; font-weight: 500;">Новый пароль</label>
                        <input asp-for="NewPassword" type="password" class="quantity-input" style="width: 100%; padding: 0.6rem;" />
                        <span asp-validation-for="NewPassword" style="color: #dc3545; font-size: 0.8rem;"></span>
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        <label asp-for="ConfirmPassword" style="display: block; margin-bottom: 0.25rem; font-weight: 500;">Подтверждение пароля</label>
                        <input asp-for="ConfirmPassword" type="password" class="quantity-input" style="width: 100%; padding: 0.6rem;" />
                        <span asp-validation-for="ConfirmPassword" style="color: #dc3545; font-size: 0.8rem;"></span>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        Сменить пароль
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}