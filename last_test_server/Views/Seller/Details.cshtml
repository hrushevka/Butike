@model last_test_server.Models.Product

@{
    ViewData["Title"] = "Детали товара";
}

<div class="container">
    <div style="max-width: 1000px; margin: 0 auto;">
        <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 1.5rem;">
            ℹ️ Детальная информация
        </h1>

        <div class="card">
            <div class="card-header" style="background: var(--brown-primary); color: white;">
                <h3 style="margin: 0;">@Model.Name</h3>
            </div>
            <div class="card-body" style="padding: 1.5rem;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                    <div>
                        <img src="@Model.ImageURL" class="product-img" alt="@Model.Name" style="width: 100%; border-radius: var(--radius-sm); box-shadow: var(--shadow-sm);"
                             onerror="this.src='https://via.placeholder.com/500x400?text=No+Image'">
                    </div>
                    <div>
                        <p style="font-size: 2rem; font-weight: 700; color: var(--brown-primary); margin-bottom: 1rem;">
                            @Model.Cost.ToString("N0") ₽
                        </p>

                        <hr style="border-color: var(--brown-light); margin: 1rem 0;">

                        <h5>📋 Информация о товаре</h5>
                        <table style="width: 100%; border-collapse: collapse; margin-top: 0.5rem;">
                            <tr>
                                <th style="padding: 0.5rem 0; text-align: left; width: 120px;">ID товара:</th>
                                <td style="padding: 0.5rem 0;">#@Model.Id</td>
                            </tr>
                            <tr>
                                <th style="padding: 0.5rem 0; text-align: left;">ID продавца:</th>
                                <td style="padding: 0.5rem 0;">@Model.SellerId</td>
                            </tr>
                            <tr>
                                <th style="padding: 0.5rem 0; text-align: left;">Дата добавления:</th>
                                <td style="padding: 0.5rem 0;">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        </table>

                        @if (!string.IsNullOrEmpty(Model.Composition))
                        {
                            <div style="margin-top: 1rem;">
                                <h5>📝 Состав и характеристики</h5>
                                <div style="background: var(--brown-bg-light); padding: 1rem; border-radius: var(--radius-sm); margin-top: 0.5rem;">
                                    @Html.Raw(Model.Composition.Replace("\n", "<br>"))
                                </div>
                            </div>
                        }

                        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn" style="background: #ffc107; color: #333; text-decoration: none; text-align: center; flex: 1;">
                                ✏️ Редактировать
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn" style="background: #dc3545; color: white; text-decoration: none; text-align: center; flex: 1;">
                                🗑️ Удалить
                            </a>
                        </div>
                        <div style="margin-top: 0.5rem;">
                            <a asp-action="Index" class="btn btn-outline" style="text-decoration: none; text-align: center; display: block;">
                                ↩️ Вернуться к списку
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>