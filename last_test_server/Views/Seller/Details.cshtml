@model last_test_server.Models.Product

@{
    ViewData["Title"] = "Детали товара";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-info-circle"></i> Детальная информация
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <img src="@Model.ImageURL" class="img-fluid rounded shadow-sm" alt="@Model.Name"
                                 onerror="this.src='https://via.placeholder.com/500x400?text=No+Image'"
                                 style="max-height: 400px; width: 100%; object-fit: contain;">
                        </div>
                        <div class="col-md-6">
                            <h1 class="display-6">@Model.Name</h1>
                            <div class="mt-3">
                                <h2 class="text-primary">@Model.Cost.ToString("N0") ₽</h2>
                            </div>

                            <hr />

                            <div class="mt-3">
                                <h5><i class="bi bi-upc-scan"></i> Информация о товаре</h5>
                                <table class="table table-borderless">
                                    <tr>
                                        <th style="width: 120px;">ID товара:</th>
                                        <td>#@Model.Id</td>
                                    </tr>
                                    <tr>
                                        <th>ID продавца:</th>
                                        <td>@Model.SellerId</td>  <!-- Исправлено: SellerId вместо UserId -->
                                    </tr>
                                    <tr>
                                        <th>Дата добавления:</th>
                                        <td>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                </table>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Composition))
                            {
                                <div class="mt-3">
                                    <h5><i class="bi bi-list-ul"></i> Состав и характеристики</h5>
                                    <div class="p-3 bg-light rounded">
                                        @Html.Raw(Model.Composition.Replace("\n", "<br>"))
                                    </div>
                                </div>
                            }

                            <div class="mt-4">
                                <div class="btn-group w-100" role="group">
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                        <i class="bi bi-pencil"></i> Редактировать
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Удалить
                                    </a>
                                </div>
                                <div class="mt-2">
                                    <a asp-action="Index" class="btn btn-secondary w-100">
                                        <i class="bi bi-arrow-left"></i> Вернуться к списку
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>