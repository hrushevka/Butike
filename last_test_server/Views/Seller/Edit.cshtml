@model last_test_server.Models.Product

@{
    ViewData["Title"] = "Редактирование товара";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Редактирование товара
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SellerId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageURL" class="form-label fw-bold"></label>
                            <input asp-for="ImageURL" class="form-control" id="ImageURL">
                            <span asp-validation-for="ImageURL" class="text-danger"></span>

                            @if (!string.IsNullOrEmpty(Model.ImageURL))
                            {
                                <div class="mt-2">
                                    <img src="@Model.ImageURL" alt="Preview" style="max-height: 150px; max-width: 100%;"
                                         onerror="this.src='https://via.placeholder.com/300x150?text=Image+not+found'">
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cost" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="Cost" class="form-control" type="number" min="0" step="1">
                                <span class="input-group-text">₽</span>
                            </div>
                            <span asp-validation-for="Cost" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Composition" class="form-label fw-bold"></label>
                            <textarea asp-for="Composition" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Composition" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Отмена
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Live preview для изображения
    document.getElementById('ImageURL').addEventListener('change', function() {
        const preview = document.querySelector('img');
        if (preview) {
            preview.src = this.value;
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}