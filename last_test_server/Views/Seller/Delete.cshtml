@model last_test_server.Models.Product

@{
    ViewData["Title"] = "Удаление товара";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Подтверждение удаления
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i> Вы уверены, что хотите удалить этот товар? Это действие нельзя отменить.
                    </div>

                    <div class="row">
                        <div class="col-md-5">
                            <img src="@Model.ImageURL" class="img-fluid rounded" alt="@Model.Name"
                                 onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'">
                        </div>
                        <div class="col-md-7">
                            <h4>@Model.Name</h4>
                            <p class="text-primary fw-bold fs-4">@Model.Cost.ToString("N0") ₽</p>
                            @if (!string.IsNullOrEmpty(Model.Composition))
                            {
                                <h6>Состав:</h6>
                                <p class="text-muted">@Model.Composition</p>
                            }
                            <p class="text-muted">
                                <small>ID товара: #@Model.Id</small>
                            </p>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Отмена
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Удалить навсегда
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>