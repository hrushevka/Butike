@model IEnumerable<last_test_server.Models.Product>

@{
    ViewData["Title"] = "Мои товары";
    var products = Model.ToList();
}

<div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 class="section-title" style="font-size: 1.8rem; border-bottom-color: var(--brown-primary); margin-bottom: 0.5rem;">
                📦 Мои товары
            </h1>
            <p style="color: var(--text-muted);">Управление вашими товарами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="text-decoration: none;">
            ➕ Добавить товар
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-notify" style="position: static; margin-bottom: 1rem; background: var(--brown-primary);">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast-notify" style="position: static; margin-bottom: 1rem; background: #dc3545;">
            ⚠ @TempData["ErrorMessage"]
        </div>
    }

    @if (!products.Any())
    {
        <div class="empty-state">
            <div style="font-size: 4rem;">📦</div>
            <h3 style="margin-top: 1rem;">У вас пока нет товаров</h3>
            <p style="color: var(--text-muted);">Нажмите кнопку "Добавить товар", чтобы начать продавать</p>
            <a asp-action="Create" class="btn btn-primary" style="text-decoration: none; display: inline-block; margin-top: 1rem;">
                ➕ Добавить первый товар
            </a>
        </div>
    }
    else
    {
        <div class="card" style="overflow-x: auto;">
            <div class="card-body" style="padding: 1.5rem;">
                <table class="seller-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: var(--brown-primary); color: white;">
                            <th style="padding: 0.75rem; text-align: left;">ID</th>
                            <th style="padding: 0.75rem; text-align: left;">Изображение</th>
                            <th style="padding: 0.75rem; text-align: left;">Название</th>
                            <th style="padding: 0.75rem; text-align: left;">Цена</th>
                            <th style="padding: 0.75rem; text-align: left;">Дата добавления</th>
                            <th style="padding: 0.75rem; text-align: center;">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr style="border-bottom: 1px solid var(--brown-light);">
                                <td style="padding: 0.75rem;">#@product.Id</td>
                                <td style="padding: 0.75rem;">
                                    <img src="@product.ImageURL" alt="@product.Name"
                                         style="height: 50px; width: 50px; object-fit: cover; border-radius: var(--radius-sm);"
                                         onerror="this.src='https://via.placeholder.com/50x50?text=No+Image'">
                                </td>
                                <td style="padding: 0.75rem;">
                                    <strong>@product.Name</strong>
                                    @if (!string.IsNullOrEmpty(product.Composition))
                                    {
                                        <br />
                                        <small style="color: var(--text-muted);">@(product.Composition.Length > 50 ? product.Composition.Substring(0, 50) + "..." : product.Composition)</small>
                                    }
                                </td>
                                <td style="padding: 0.75rem;">
                                    <strong style="color: var(--brown-primary);">@product.Cost.ToString("N0") ₽</strong>
                                </td>
                                <td style="padding: 0.75rem;">@product.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td style="padding: 0.75rem; text-align: center;">
                                    <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn-edit-small" title="Редактировать" style="text-decoration: none;">
                                            ✏️
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn-delete-small" title="Удалить" style="text-decoration: none;">
                                            🗑️
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div style="margin-top: 1rem;">
            <small style="color: var(--text-muted);">Всего товаров: @products.Count()</small>
        </div>
    }
</div>

<style>
    .seller-table {
        width: 100%;
        border-collapse: collapse;
    }
    
    .seller-table th {
        background: var(--brown-primary);
        color: white;
        padding: 0.75rem;
        text-align: left;
    }
    
    .seller-table td {
        padding: 0.75rem;
        border-bottom: 1px solid var(--brown-light);
    }
    
    .seller-table tr:hover {
        background: var(--brown-bg-light);
    }
    
    .btn-edit-small,
    .btn-delete-small {
        display: inline-block;
        padding: 0.3rem 0.6rem;
        border-radius: var(--radius-sm);
        font-size: 1rem;
        transition: var(--transition);
    }
    
    .btn-edit-small:hover {
        background: var(--brown-light);
        transform: scale(1.1);
    }
    
    .btn-delete-small:hover {
        background: #dc3545;
        color: white;
        transform: scale(1.1);
    }
    
    @@media (max-width: 768px) {
        .seller-table th,
        .seller-table td {
            padding: 0.5rem;
            font-size: 0.8rem;
        }
    }
</style>