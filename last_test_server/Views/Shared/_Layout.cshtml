<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Butike</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Красивый коричневый хедер -->
    <nav class="navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🛍️ Butike
            </a>

            <button class="navbar-toggler" id="menuToggle" aria-label="Меню">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            🏠 Главная
                        </a>
                    </li>
                    @if (User.IsInRole("Seller"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Seller" asp-action="Index">
                                📦 Мои товары
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Buyer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-link" asp-area="" asp-controller="Cart" asp-action="Index">
                                🛒 Корзина
                                <span class="cart-count-badge" id="cartCount" style="display: none;">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="OrderHistory">
                                📋 Заказы
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                👥 Пользователи
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Orders">
                                Заказы
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown">
                                👤 @User.Identity.Name
                            </a>
                            <div class="dropdown-menu" id="userDropdownMenu">
                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                    ⚙️ Профиль
                                </a>
                                @if (User.IsInRole("Buyer"))
                                {
                                    <a class="dropdown-item" asp-controller="Cart" asp-action="OrderHistory">
                                        📋 Мои заказы
                                    </a>
                                }
                                <hr class="dropdown-divider">
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item logout-btn">
                                        🚪 Выйти
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                🔑 Вход
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-register" asp-controller="Account" asp-action="Register">
                                📝 Регистрация
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="toast-notify" style="position: static; margin-bottom: 1rem; background: var(--brown-primary);">
                    ✓ @TempData["SuccessMessage"]
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // Мобильное меню
        document.getElementById('menuToggle')?.addEventListener('click', function() {
            const navCollapse = document.getElementById('navbarNav');
            navCollapse.classList.toggle('show');
            this.classList.toggle('active');
        });

        // Выпадающее меню пользователя
        const userDropdown = document.getElementById('userDropdown');
        const userMenu = document.getElementById('userDropdownMenu');

        if (userDropdown && userMenu) {
            userDropdown.addEventListener('click', function(e) {
                e.preventDefault();
                userMenu.classList.toggle('show');
            });

            // Закрытие при клике вне меню
            document.addEventListener('click', function(e) {
                if (!userDropdown.contains(e.target) && !userMenu.contains(e.target)) {
                    userMenu.classList.remove('show');
                }
            });
        }

        // Функция для обновления счетчика корзины
        function updateCartCount() {
            if (typeof $ !== 'undefined') {
                $.ajax({
                    url: '@Url.Action("GetCartCount", "Cart")',
                    type: 'GET',
                    success: function(count) {
                        const cartBadge = document.getElementById('cartCount');
                        if (cartBadge) {
                            if (count > 0) {
                                cartBadge.textContent = count;
                                cartBadge.style.display = 'inline-block';
                            } else {
                                cartBadge.style.display = 'none';
                            }
                        }
                    },
                    error: function() {
                        console.log('Не удалось обновить счетчик корзины');
                    }
                });
            }
        }

        // Запускаем обновление счетчика при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>